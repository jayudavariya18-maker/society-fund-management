# Bajrang Society Fund Management System - Environment Configuration
# Copy this file to .env and configure your Supabase instance credentials.

# Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Safe for client apps)
# NEVER commit the service_role key to Flutter or client repositories!
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Single Society ID (UUID of the registered residential society)
SOCIETY_ID=00000000-0000-0000-0000-000000000001

# Environment Mode: 'production' or 'development'
# In 'development', mock OTP verification and dev shortcuts can be enabled.
APP_ENV=development

# Storage Bucket Names in Supabase Storage
STORAGE_BUCKET_BILLS=expense-bills
STORAGE_BUCKET_RECEIPTS=contribution-receipts
STORAGE_BUCKET_FESTIVALS=festival-media
STORAGE_BUCKET_ANNOUNCEMENTS=announcement-docs
